class Solution(object):
    def subsets(self, nums):
        """
        :type nums: List[int]
        :rtype: List[List[int]]
        """
        result = []
        def back(curr, index):
            if index == len(nums):
                result.append(list(curr))
                return
            curr.append(nums[index])
            back(curr, index+1)
            curr.pop()
            back(curr, index+1)
        back([], 0)
        return result
